# Doxyfile — конфигурация Doxygen для проекта «Калькулятор матриц».
# Получен командой `doxygen -g`; ниже оставлены только изменённые параметры,
# остальные используют значения по умолчанию.

#---------------------------------------------------------------------------
# Проект
#---------------------------------------------------------------------------
PROJECT_NAME           = "Matrix Calculator"
PROJECT_NUMBER         = 1.0
PROJECT_BRIEF          = "Библиотека для работы с матрицами (ЛР3, вариант 6)"
OUTPUT_DIRECTORY       = docs
OUTPUT_LANGUAGE        = Russian
INPUT_ENCODING         = UTF-8
MARKDOWN_SUPPORT       = YES
FULL_PATH_NAMES        = NO

#---------------------------------------------------------------------------
# Что извлекать
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_ANON_NSPACES   = YES

#---------------------------------------------------------------------------
# Входные файлы
#---------------------------------------------------------------------------
INPUT                  = README.md include src
FILE_PATTERNS          = *.h *.cpp *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
SOURCE_BROWSER         = YES

#---------------------------------------------------------------------------
# Формат вывода
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
HTML_COLORSTYLE        = LIGHT
GENERATE_LATEX         = NO

#---------------------------------------------------------------------------
# Диаграммы (Graphviz)
#---------------------------------------------------------------------------
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = NO

#---------------------------------------------------------------------------
# Предупреждения
#---------------------------------------------------------------------------
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
